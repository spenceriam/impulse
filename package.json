{
  "name": "@spenceriam/impulse",
  "version": "1.0.1",
  "private": true,
  "description": "Terminal-based provider-flexible AI coding agent for fast software development",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun run scripts/build.ts",
    "start": "bun run dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mariozechner/pi-tui": "^0.73.0",
    "@vscode/ripgrep": "^1.18.0",
    "agent-browser": "^0.27.0",
    "diff": "^8.0.3",
    "glob": "^13.0.6",
    "openai": "^4.73.0",
    "semver": "^7.7.3",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.6",
    "@types/diff": "^8.0.0",
    "@types/node": "^22.10.0",
    "@types/semver": "^7.7.1",
    "typescript": "^5.7.0"
  },
  "bin": {
    "impulse": "dist/index.js"
  },
  "files": [
    "dist/**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai",
    "cli",
    "impulse",
    "terminal",
    "coding",
    "agent",
    "z-ai",
    "coding-plan",
    "multi-provider"
  ],
  "author": "Spencer Francisco",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spenceriam/impulse.git"
  },
  "homepage": "https://github.com/spenceriam/impulse#readme",
  "bugs": {
    "url": "https://github.com/spenceriam/impulse/issues"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
}
